# Copy this file to ".env" and fill in your real values.
# The real .env is git-ignored and must NEVER be uploaded to GitHub.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=@your_channel_username
ANTHROPIC_API_KEY=sk-ant-...

# Optional: the single Telegram user id allowed to add words / use commands.
# Defaults to the value baked into language_daily_bot.py if left unset.
# TELEGRAM_ALLOWED_USER_ID=142201469
